{
  "name": "oh-my-stack",
  "version": "0.2.0-alpha.5",
  "description": "Portable, verifiable engineering workflows for agent runtimes.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/williamwue/oh-my-stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamwue/oh-my-stack.git"
  },
  "bugs": {
    "url": "https://github.com/williamwue/oh-my-stack/issues"
  },
  "scripts": {
    "generate": "node tools/generate.mjs",
    "generate:check": "node tools/generate.mjs --check",
    "generate:probes": "node tools/generate.mjs --include-probes",
    "conformance": "node tools/build-conformance.mjs",
    "conformance:check": "node tools/build-conformance.mjs --check",
    "release:build": "node tools/build-release.mjs",
    "release:check": "node tools/build-release.mjs --check",
    "validate": "node tools/validate.mjs",
    "lint:markdown": "markdownlint-cli2 '**/*.md'",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run generate:check && npm run conformance:check && npm run release:check && npm run validate && npm run lint:markdown && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "markdownlint-cli2": "0.23.3"
  }
}
