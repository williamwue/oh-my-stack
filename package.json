{
  "name": "pstack",
  "private": true,
  "version": "3.0.1",
  "description": "If you want to go fast, go deep first. pstack helps you write less, but higher quality code. rigorous agent workflows you can parallelize with confidence. Pi and OpenCode package of the Claude Code plugin; skills are shared, and runtime mappings translate tool names. Original pstack by Lauren Tan (poteto).",
  "author": {
    "name": "Michael Denyer",
    "url": "https://github.com/michael-denyer"
  },
  "homepage": "https://github.com/michael-denyer/pstack-claude",
  "repository": "https://github.com/michael-denyer/pstack-claude",
  "license": "MIT",
  "bin": {
    "t3-pstack": "tools/install.mjs"
  },
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop",
    "claude-code",
    "skills",
    "tdd",
    "code-review",
    "parallel-agents",
    "codex",
    "opencode",
    "gemini-cli",
    "prime-agent"
  ],
  "pi": {
    "skills": [
      "./plugins/pstack/skills"
    ],
    "extensions": [
      "./plugins/pstack/pi/index.ts"
    ]
  },
  "exports": {
    "./server": "./plugins/pstack/opencode/index.js"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
