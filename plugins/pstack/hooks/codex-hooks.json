{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\" codex",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ps1\" codex",
            "statusMessage": "Loading pstack routing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(.*[:._/])?spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/codex-pre-tool-use.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/codex-pre-tool-use.ps1\"",
            "statusMessage": "Checking pstack subagent model"
          }
        ]
      }
    ]
  }
}
