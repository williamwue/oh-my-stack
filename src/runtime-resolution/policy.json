    "how.explainer": { "kind": "single", "role": "explainer", "workload": "deep" },
    "why.investigator": { "kind": "single", "role": "explorer", "workload": "fast" },
    "why.synthesizer": { "kind": "single", "role": "synthesizer", "workload": "deep" },
