{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-stack.invalid/schemas/conformance-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenario",
    "profile",
    "sourceEvidence",
    "result",
    "coordinate",
    "providerInventoryEvidence",
    "modelResolution",
    "fixture",
    "repetitions",
    "semanticTrace",
    "assertions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "scenario": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "profile": { "type": "string" },
    "sourceEvidence": { "type": "string" },
    "result": { "const": "pass" },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "surface", "version", "platform", "configurationFingerprint", "permissionProfile"],
      "properties": {
        "runtime": { "type": "string" },
        "surface": { "type": "string" },
        "version": { "type": "string" },
        "platform": { "type": "string" },
        "configurationFingerprint": { "type": "string" },
        "permissionProfile": { "type": "string" }
      }
    },
    "providerInventoryEvidence": { "type": "string" },
    "modelResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "details"],
      "properties": {
        "status": { "enum": ["observed", "not-recorded"] },
        "details": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "artifacts"],
      "properties": {
        "path": { "type": "string" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "attempts", "passed", "acceptableFailures"],
      "properties": {
        "required": { "type": "integer", "minimum": 1 },
        "attempts": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 1 },
        "acceptableFailures": { "type": "integer", "minimum": 0 }
      }
    },
    "semanticTrace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "event", "actor", "evidenceAssertion"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "event": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
          "actor": { "enum": ["root", "writer", "reviewer", "candidate", "synthesizer"] },
          "evidenceAssertion": { "type": "string" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "sourceAssertions"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["pass", "not-applicable"] },
          "sourceAssertions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
