{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-stack.invalid/schemas/model-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "observedAt", "source", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtime": { "enum": ["omp", "codex", "claude-code"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reasoningEfforts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reasoningEfforts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
          }
        }
      }
    }
  }
}
