{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-stack.invalid/schemas/capability-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "target", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "target": {
      "type": "object",
      "required": ["runtime", "surface", "runtimeVersion", "platform", "configurationFingerprint", "permissionProfile"],
      "properties": {
        "runtime": { "type": "string" },
        "surface": { "type": "string" },
        "runtimeVersion": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] },
        "configurationFingerprint": { "type": ["string", "null"] },
        "permissionProfile": { "type": ["string", "null"] },
        "installedProviders": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["active", "pending"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "provider", "evidence"],
        "properties": {
          "status": { "enum": ["native", "extension", "external", "fallback", "unsupported", "unknown"] },
          "provider": { "type": ["string", "null"] },
          "evidence": { "type": ["string", "null"] }
        }
      }
    }
  }
}
