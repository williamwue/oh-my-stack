{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-stack.invalid/schemas/t3-resolution.schema.json",
  "title": "Oh My Stack T3 resolution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "orchestration", "preset", "roles", "routes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "owner": { "const": "oh-my-stack" },
    "orchestration": { "const": "t3" },
    "preset": { "type": "string", "minLength": 1 },
    "roles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/target" } },
    "routes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/route" } },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelFamilies": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "roleCandidates": { "type": "object", "additionalProperties": { "$ref": "#/$defs/candidates" } },
        "fallbackTargets": { "$ref": "#/$defs/candidates" },
        "modelFallbacks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interrogate.reviewers": { "allOf": [{ "$ref": "#/$defs/modelFallback" }, { "properties": { "strategy": { "const": "interrogate" } } }] },
            "arena.runners": { "allOf": [{ "$ref": "#/$defs/modelFallback" }, { "properties": { "strategy": { "const": "arena" } } }] },
            "architect.runners": { "allOf": [{ "$ref": "#/$defs/modelFallback" }, { "properties": { "strategy": { "const": "arena" } } }] }
          }
        },
        "minimumPanelFamilies": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 2 } }
      }
    }
  },
  "$defs": {
    "modelFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "familyDefaults", "unknownFamilyDefault"],
      "properties": {
        "strategy": { "enum": ["interrogate", "arena"] },
        "familyDefaults": { "type": "object", "additionalProperties": { "$ref": "#/$defs/explicitTarget" } },
        "unknownFamilyDefault": { "$ref": "#/$defs/explicitTarget" }
      }
    },
    "candidates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/explicitTarget" } },
    "explicitTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerInstanceId", "model", "options"],
      "properties": {
        "providerInstanceId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "options": { "type": "object", "additionalProperties": { "type": ["string", "boolean"] } }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["inheritParent"],
          "properties": { "inheritParent": { "const": true } }
        },
        { "$ref": "#/$defs/explicitTarget" }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entries"],
      "properties": {
        "kind": { "enum": ["single", "panel"] },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/target" } }
      },
      "if": { "properties": { "kind": { "const": "single" } } },
      "then": { "properties": { "entries": { "minItems": 1, "maxItems": 1 } } }
    }
  }
}
