{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-stack.invalid/schemas/skill-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "public",
    "probes",
    "extensions",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "public": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "probes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "enhanced-delivery",
          "extras",
          "aihero"
        ]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "origin",
          "distribution"
        ],
        "properties": {
          "kind": {
            "enum": [
              "skill",
              "role",
              "reference",
              "script",
              "hook",
              "manifest"
            ]
          },
          "distribution": {
            "enum": [
              "core",
              "none",
              "enhanced-delivery",
              "extras",
              "aihero"
            ]
          },
          "path": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          }
        }
      }
    }
  }
}
