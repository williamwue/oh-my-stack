{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-stack.invalid/schemas/adapter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "packageDir", "skillsDir", "manifestPath", "profiles", "manifest"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "enum": ["omp", "codex", "claude-code"] },
    "packageDir": { "type": "string", "pattern": "^packages/[a-z-]+$" },
    "skillsDir": { "const": "skills" },
    "manifestPath": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "manifest": { "type": "object" }
  }
}
