{
  "ignores": [
    "node_modules/**",
    "upstream/snapshots/**"
  ],
  "overrides": [
    {
      "filter": [
        "src/core/skills/principle-*/**/*.md",
        "packages/*/skills/principle-*/**/*.md"
      ],
      "config": {
        "MD032": false,
        "MD036": false
      },
      "combine": "merge"
    }
  ],
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    }
  }
}
