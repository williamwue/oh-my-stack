{
  "ignores": [
    ".tmp/**",
    "node_modules/**",
    "upstream/snapshots/**"
  ],
  "overrides": [
    {
      "filter": [
        "src/core/skills/principle-*/**/*.md",
        "packages/*/skills/principle-*/**/*.md"
      ],
      "config": {
        "MD032": false,
        "MD036": false
      },
      "combine": "merge"
    },
    {
      "filter": [
        "src/core/skills/unslop/SKILL.md",
        "packages/*/skills/unslop/SKILL.md"
      ],
      "config": {
        "MD029": false
      },
      "combine": "merge"
    },
    {
      "filter": [
        "docs/operations/cloud-management-acceptance-2026-10-01.md"
      ],
      "config": {
        "MD060": false,
        "MD012": false
      },
      "combine": "merge"
    },
    {
      "filter": [
        "docs/omp-18.2.9-live-test-plan.md"
      ],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    }
  ],
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    }
  }
}
