      {
        "id": "%E3%81%AA%E3%81%9C%E8%87%AA%E5%8B%95%E5%8C%96%E3%82%92%E6%9C%80%E5%BE%8C%E3%81%AB%E7%BD%AE%E3%81%8F%E3%81%AE%E3%81%8B",
        "text": "なぜ自動化を最後に置くのか",
