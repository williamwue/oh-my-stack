{
  "schemaVersion": 1,
  "target": "codex",
  "workloads": {
    "fast": {
      "reasoningPreference": "low"
    },
    "balanced": {
      "reasoningPreference": "medium"
    },
    "deep": {
      "reasoningPreference": "high"
    }
  },
  "roles": [
    {
      "name": "evidence-reader",
      "workload": "fast",
      "constraints": [
        "read_only",
        "independent_session"
      ],
      "writes": false
    },
    {
      "name": "explainer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required"
      ],
      "writes": false
    },
    {
      "name": "explorer",
      "workload": "balanced",
      "constraints": [
        "read_only",
        "independent_session"
      ],
      "writes": false
    },
    {
      "name": "implementer",
      "workload": "balanced",
      "constraints": [
        "independent_session",
        "reasoning_required"
      ],
      "writes": true
    },
    {
      "name": "reviewer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required",
        "model_diversity_preferred"
      ],
      "writes": false
    },
    {
      "name": "synthesizer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required"
      ],
      "writes": false
    },
    {
      "name": "trail-reviewer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required",
        "model_diversity_preferred"
      ],
      "writes": false
    }
  ],
  "routes": {
    "code.delegates": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "judgment.prose": {
      "kind": "single",
      "role": "explainer",
      "workload": "deep"
    },
    "hardest.tasks": {
      "kind": "single",
      "role": "synthesizer",
      "workload": "deep"
    },
    "how.explorer": {
      "kind": "single",
      "role": "explorer",
      "workload": "fast"
    },
    "how.explainer": {
      "kind": "single",
      "role": "explainer",
      "workload": "deep"
    },
    "why.investigator": {
      "kind": "single",
      "role": "explorer",
      "workload": "fast"
    },
    "why.synthesizer": {
      "kind": "single",
      "role": "synthesizer",
      "workload": "deep"
    },
    "reflect.tooling": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "reflect.judgment": {
      "kind": "single",
      "role": "reviewer",
      "workload": "deep"
    },
    "swarm.workers": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "arena.runners": {
      "kind": "panel",
      "role": "implementer",
      "workload": "deep",
      "defaultCount": 3
    },
    "arena.cross-judge-pool": {
      "kind": "panel",
      "role": "reviewer",
      "workload": "deep",
      "defaultCount": 3
    },
    "architect.runners": {
      "kind": "panel",
      "role": "explorer",
      "workload": "deep",
      "defaultCount": 3
    },
    "interrogate.reviewers": {
      "kind": "panel",
      "role": "reviewer",
      "workload": "deep",
      "defaultCount": 3
    }
  },
  "presets": {
    "pstack": {
      "workloads": {
        "fast": "gpt-6-luna@low",
        "balanced": "gpt-6-sol@medium",
        "deep": "gpt-6-astra@low"
      },
      "routes": {
        "reflect.tooling": "gpt-6-sol@medium",
        "arena.runners": [
          "gpt-6-astra@low",
          "gpt-6-sol@medium",
          "gpt-6-luna@high"
        ],
        "arena.cross-judge-pool": [
          "gpt-6-astra@low",
          "gpt-6-sol@medium",
          "gpt-6-luna@high"
        ],
        "architect.runners": [
          "gpt-6-astra@low",
          "gpt-6-sol@medium",
          "gpt-6-luna@high"
        ],
        "interrogate.reviewers": [
          "gpt-6-astra@low",
          "gpt-6-sol@medium",
          "gpt-6-luna@high"
        ]
      }
    }
  },
  "adapter": {
    "format": "toml",
    "modelField": "model",
    "reasoningField": "model_reasoning_effort"
  }
}
