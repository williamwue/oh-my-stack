        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/codex-routing-hook.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
