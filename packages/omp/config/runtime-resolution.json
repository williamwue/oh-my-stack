{
  "schemaVersion": 1,
  "target": "omp",
  "workloads": {
    "fast": {
      "reasoningPreference": "low"
    },
    "balanced": {
      "reasoningPreference": "medium"
    },
    "deep": {
      "reasoningPreference": "high"
    }
  },
  "roles": [
    {
      "name": "evidence-reader",
      "workload": "fast",
      "constraints": [
        "read_only",
        "independent_session"
      ],
      "writes": false
    },
    {
      "name": "explainer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required"
      ],
      "writes": false
    },
    {
      "name": "explorer",
      "workload": "balanced",
      "constraints": [
        "read_only",
        "independent_session"
      ],
      "writes": false
    },
    {
      "name": "implementer",
      "workload": "balanced",
      "constraints": [
        "independent_session",
        "reasoning_required"
      ],
      "writes": true
    },
    {
      "name": "reviewer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required",
        "model_diversity_preferred"
      ],
      "writes": false
    },
    {
      "name": "synthesizer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required"
      ],
      "writes": false
    },
    {
      "name": "trail-reviewer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required",
        "model_diversity_preferred"
      ],
      "writes": false
    }
  ],
  "routes": {
    "code.delegates": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "judgment.prose": {
      "kind": "single",
      "role": "explainer",
      "workload": "deep"
    },
    "hardest.tasks": {
      "kind": "single",
      "role": "synthesizer",
      "workload": "deep"
    },
    "how.explorer": {
      "kind": "single",
      "role": "explorer",
      "workload": "fast"
    },
    "how.explainer": {
      "kind": "single",
      "role": "explainer",
      "workload": "deep"
    },
    "why.investigator": {
      "kind": "single",
      "role": "explorer",
      "workload": "fast"
    },
    "why.synthesizer": {
      "kind": "single",
      "role": "synthesizer",
      "workload": "deep"
    },
    "reflect.tooling": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "reflect.judgment": {
      "kind": "single",
      "role": "reviewer",
      "workload": "deep"
    },
    "swarm.workers": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "arena.runners": {
      "kind": "panel",
      "role": "implementer",
      "workload": "deep",
      "defaultCount": 3
    },
    "arena.cross-judge-pool": {
      "kind": "panel",
      "role": "reviewer",
      "workload": "deep",
      "defaultCount": 3
    },
    "architect.runners": {
      "kind": "panel",
      "role": "explorer",
      "workload": "deep",
      "defaultCount": 3
    },
    "interrogate.reviewers": {
      "kind": "panel",
      "role": "reviewer",
      "workload": "deep",
      "defaultCount": 3
    },
    "code.feature-refactoring": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "code.bug-fix": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "code.perf-issue": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "code.hillclimb": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "reflect.divergent": {
      "kind": "single",
      "role": "reviewer",
      "workload": "deep"
    },
    "reflect.synthesizer": {
      "kind": "single",
      "role": "synthesizer",
      "workload": "deep"
    }
  },
  "presets": {
    "pstack-openai-codex": {
      "workloads": {
        "fast": "openai-codex/gpt-6-luna@low",
        "balanced": "openai-codex/gpt-6-sol@medium",
        "deep": "openai-codex/gpt-6-astra@low"
      },
      "routes": {
        "code.feature-refactoring": "openai-codex/gpt-6-sol@medium",
        "code.bug-fix": "openai-codex/gpt-6-sol@medium",
        "code.perf-issue": "openai-codex/gpt-6-sol@medium",
        "code.hillclimb": "openai-codex/gpt-6-sol@medium",
        "reflect.tooling": "openai-codex/gpt-6-sol@medium",
        "reflect.divergent": "openai-codex/gpt-6-astra@low",
        "reflect.synthesizer": "openai-codex/gpt-6-astra@low",
        "arena.runners": [
          "openai-codex/gpt-6-astra@low",
          "openai-codex/gpt-6-sol@medium",
          "openai-codex/gpt-6-luna@high"
        ],
        "arena.cross-judge-pool": [
          "openai-codex/gpt-6-astra@low",
          "openai-codex/gpt-6-sol@medium",
          "openai-codex/gpt-6-luna@high"
        ],
        "architect.runners": [
          "openai-codex/gpt-6-astra@low",
          "openai-codex/gpt-6-sol@medium",
          "openai-codex/gpt-6-luna@high"
        ],
        "interrogate.reviewers": [
          "openai-codex/gpt-6-astra@low",
          "openai-codex/gpt-6-sol@medium",
          "openai-codex/gpt-6-luna@high"
        ]
      }
    },
    "pstack": {
      "workloads": {
        "fast": "cursor/grok-4.7-xhigh-fast@high",
        "balanced": "cursor/grok-4.7-xhigh-fast@high",
        "deep": "cursor/claude-opus-5-5@max"
      },
      "routes": {
        "code.feature-refactoring": "cursor/grok-4.7-xhigh-fast@high",
        "code.bug-fix": "cursor/grok-4.7-xhigh-fast@high",
        "code.perf-issue": "cursor/grok-4.7-xhigh-fast@high",
        "code.hillclimb": "cursor/grok-4.7-xhigh-fast@high",
        "reflect.tooling": "cursor/gpt-5.6-sol@max",
        "reflect.divergent": "cursor/claude-opus-5-5@max",
        "reflect.synthesizer": "cursor/claude-opus-5-5@max",
        "arena.runners": [
          "cursor/claude-opus-5-5@max",
          "cursor/gpt-5.6-sol@max",
          "cursor/grok-4.7-xhigh-fast@high"
        ],
        "arena.cross-judge-pool": [
          "cursor/claude-opus-5-5@max",
          "cursor/gpt-5.6-sol@max",
          "cursor/grok-4.7-xhigh-fast@high"
        ],
        "architect.runners": [
          "cursor/claude-opus-5-5@max",
          "cursor/gpt-5.6-sol@max",
          "cursor/grok-4.7-xhigh-fast@high"
        ],
        "interrogate.reviewers": [
          "cursor/claude-opus-5-5@max",
          "cursor/gpt-5.6-sol@max",
          "cursor/grok-4.7-xhigh-fast@high"
        ]
      }
    }
  },
  "adapter": {
    "format": "yaml",
    "modelField": "model",
    "reasoningField": "thinkingLevel"
  }
}
