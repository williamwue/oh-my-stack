{
  "schemaVersion": 1,
  "target": "pi",
  "workloads": {
    "fast": {
      "reasoningPreference": "low"
    },
    "balanced": {
      "reasoningPreference": "medium"
    },
    "deep": {
      "reasoningPreference": "high"
    }
  },
  "roles": [
    {
      "name": "comment-sicko",
      "workload": "balanced",
      "constraints": [
        "independent_session",
        "reasoning_required"
      ],
      "writes": true
    },
    {
      "name": "evidence-reader",
      "workload": "fast",
      "constraints": [
        "read_only",
        "independent_session"
      ],
      "writes": false
    },
    {
      "name": "explainer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required"
      ],
      "writes": false
    },
    {
      "name": "explorer",
      "workload": "balanced",
      "constraints": [
        "read_only",
        "independent_session"
      ],
      "writes": false
    },
    {
      "name": "implementer",
      "workload": "balanced",
      "constraints": [
        "independent_session",
        "reasoning_required"
      ],
      "writes": true
    },
    {
      "name": "poteto-agent",
      "workload": "balanced",
      "constraints": [
        "independent_session",
        "reasoning_required"
      ],
      "writes": true
    },
    {
      "name": "reviewer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required",
        "model_diversity_preferred"
      ],
      "writes": false
    },
    {
      "name": "synthesizer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required"
      ],
      "writes": false
    },
    {
      "name": "trail-reviewer",
      "workload": "deep",
      "constraints": [
        "read_only",
        "independent_session",
        "reasoning_required",
        "model_diversity_preferred"
      ],
      "writes": false
    }
  ],
  "routes": {
    "code.delegates": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "judgment.prose": {
      "kind": "single",
      "role": "explainer",
      "workload": "deep"
    },
    "hardest.tasks": {
      "kind": "single",
      "role": "implementer",
      "workload": "deep"
    },
    "how.explorer": {
      "kind": "single",
      "role": "explorer",
      "workload": "fast"
    },
    "how.explainer": {
      "kind": "single",
      "role": "explainer",
      "workload": "deep"
    },
    "why.investigator": {
      "kind": "single",
      "role": "explorer",
      "workload": "fast"
    },
    "why.synthesizer": {
      "kind": "single",
      "role": "synthesizer",
      "workload": "deep"
    },
    "reflect.tooling": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "reflect.judgment": {
      "kind": "single",
      "role": "reviewer",
      "workload": "deep"
    },
    "swarm.workers": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "arena.runners": {
      "kind": "panel",
      "role": "implementer",
      "workload": "deep",
      "defaultCount": 2
    },
    "arena.cross-judge-pool": {
      "kind": "panel",
      "role": "reviewer",
      "workload": "deep",
      "defaultCount": 2
    },
    "architect.runners": {
      "kind": "panel",
      "role": "explorer",
      "workload": "deep",
      "defaultCount": 2
    },
    "interrogate.reviewers": {
      "kind": "panel",
      "role": "reviewer",
      "workload": "deep",
      "defaultCount": 2
    },
    "role.comment-sicko": {
      "kind": "single",
      "role": "comment-sicko",
      "workload": "balanced"
    },
    "role.evidence-reader": {
      "kind": "single",
      "role": "evidence-reader",
      "workload": "fast"
    },
    "role.explainer": {
      "kind": "single",
      "role": "explainer",
      "workload": "deep"
    },
    "role.explorer": {
      "kind": "single",
      "role": "explorer",
      "workload": "balanced"
    },
    "role.implementer": {
      "kind": "single",
      "role": "implementer",
      "workload": "balanced"
    },
    "role.poteto-agent": {
      "kind": "single",
      "role": "poteto-agent",
      "workload": "balanced"
    },
    "role.reviewer": {
      "kind": "single",
      "role": "reviewer",
      "workload": "deep"
    },
    "role.synthesizer": {
      "kind": "single",
      "role": "synthesizer",
      "workload": "deep"
    },
    "role.trail-reviewer": {
      "kind": "single",
      "role": "trail-reviewer",
      "workload": "deep"
    }
  },
  "presets": {
    "pstack-openai-codex": null,
    "pstack": null
  },
  "adapter": {
    "format": "json",
    "modelField": "model",
    "reasoningField": "reasoning"
  }
}
